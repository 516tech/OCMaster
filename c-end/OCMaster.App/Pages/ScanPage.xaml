<Page x:Class="OCMaster.App.Pages.ScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,20,0,0">
                <Button x:Name="ScanBtn" Content="开始扫描" Click="ScanBtn_Click"
                        FontSize="18" Padding="24,14"
                        HorizontalAlignment="Center" />
                <controls:ProgressRing x:Name="ScanProgress"
                              HorizontalAlignment="Center" />
                <TextBlock x:Name="HintText" Text="点击按钮一键扫描您的硬件信息"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" FontSize="13" />
            </StackPanel>

            <controls:InfoBar x:Name="ErrorBar" Severity="Error"
                     Title="扫描失败" />
            <controls:InfoBar x:Name="DllWarning" Severity="Warning"
                     Title="扫描模块未安装"
                     Message="请确认 hardware_scanner.dll 已编译并放在程序目录下" />

            <StackPanel x:Name="HardwarePanel" Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="硬件信息" FontSize="18" FontWeight="SemiBold" />

                <controls:Expander Header="CPU 处理器" IsExpanded="True">
                    <StackPanel Spacing="4" Padding="12,8">
                        <TextBlock x:Name="CpuModelText" />
                        <TextBlock x:Name="CpuCoresText" />
                        <TextBlock x:Name="CpuFreqText" />
                    </StackPanel>
                </controls:Expander>

                <controls:Expander Header="主板 Motherboard" IsExpanded="False">
                    <StackPanel Spacing="4" Padding="12,8">
                        <TextBlock x:Name="MbBrandText" />
                        <TextBlock x:Name="MbModelText" />
                        <TextBlock x:Name="MbBiosText" />
                    </StackPanel>
                </controls:Expander>

                <controls:Expander Header="内存 RAM" IsExpanded="False">
                    <StackPanel Spacing="4" Padding="12,8">
                        <TextBlock x:Name="RamCapacityText" />
                        <TextBlock x:Name="RamSticksText" />
                        <TextBlock x:Name="RamChannelsText" />
                    </StackPanel>
                </controls:Expander>

                <controls:Expander Header="显卡 GPU" IsExpanded="False">
                    <StackPanel Spacing="4" Padding="12,8">
                        <TextBlock x:Name="GpuModelText" />
                        <TextBlock x:Name="GpuVRamText" />
                    </StackPanel>
                </controls:Expander>

                <controls:Expander Header="电源 PSU" IsExpanded="False">
                    <StackPanel Spacing="4" Padding="12,8">
                        <TextBlock Text="电源信息需手动输入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </controls:Expander>

                <Button x:Name="ExportBtn" Content="导出 TXT" Click="ExportBtn_Click"
                        HorizontalAlignment="Right" Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
