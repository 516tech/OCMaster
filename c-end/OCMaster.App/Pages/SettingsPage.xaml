<Page x:Class="OCMaster.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" MaxWidth="500">
        <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />

        <TextBlock Text="API 地址" FontWeight="SemiBold" />
        <TextBox x:Name="ApiUrlInput" PlaceholderText="https://your-server.com/api/v1" />

        <TextBlock Text="语言" FontWeight="SemiBold" />
        <ComboBox x:Name="LanguageCombo" SelectedIndex="0">
            <ComboBoxItem Content="中文" Tag="zh-CN" />
            <ComboBoxItem Content="English" Tag="en-US" />
        </ComboBox>

        <CheckBox x:Name="AutoScanCheck" Content="启动时自动扫描" IsChecked="True" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="取消" Click="CancelBtn_Click" />
            <Button Content="保存" Click="SaveBtn_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Page>
