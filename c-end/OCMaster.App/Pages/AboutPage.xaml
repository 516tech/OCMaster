<Page x:Class="OCMaster.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MaxWidth="400" HorizontalAlignment="Center" Margin="0,40,0,0">
        <TextBlock Text="超频大师 OCMaster" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" Text="版本: ---" FontSize="14"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" />

        <StackPanel Spacing="4" Margin="0,20,0,0">
            <TextBlock Text="技术栈" FontWeight="SemiBold" FontSize="16" />
            <TextBlock>· WinUI 3 (Windows 10/11 原生 UI)</TextBlock>
            <TextBlock>· Go DLL 硬件扫描 (WMI / sysfs / IOKit)</TextBlock>
            <TextBlock>· Go Backend + Vue 3 商家端</TextBlock>
        </StackPanel>

        <StackPanel Spacing="4" Margin="0,8,0,0">
            <TextBlock Text="支持平台" FontWeight="SemiBold" FontSize="16" />
            <TextBlock>· Windows 10 1809+ / Windows 11</TextBlock>
            <TextBlock>· CLI: Windows / macOS / Linux (静态编译)</TextBlock>
        </StackPanel>
    </StackPanel>
</Page>
