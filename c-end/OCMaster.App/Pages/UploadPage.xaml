<Page x:Class="OCMaster.App.Pages.UploadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Spacing="16" MaxWidth="500">
        <TextBlock Text="上传并获取分享码" FontSize="20" FontWeight="SemiBold" />

        <controls:InfoBar Severity="Informational" IsOpen="True"
                 Title="隐私提示"
                 Message="您即将上传硬件信息到云端。数据仅用于超频服务商为您提供建议，保存 7 天后自动删除。" />

        <Button x:Name="UploadBtn" Content="上传硬件信息" Click="UploadBtn_Click"
                FontSize="16" Padding="24,12" HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}" />
        <controls:ProgressRing x:Name="UploadProgress" Visibility="Collapsed"
                      HorizontalAlignment="Center" />

        <StackPanel x:Name="CodePanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="分享码（7天有效）：" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock x:Name="CodeText" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" FontFamily="Consolas"
                       CharacterSpacing="200" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button x:Name="CopyBtn" Content="一键复制" Click="CopyBtn_Click" />
                <Button x:Name="DeleteBtn" Content="删除云端数据" Click="DeleteBtn_Click"
                        Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <controls:InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False"
                 Title="上传失败" />
    </StackPanel>
</Page>
