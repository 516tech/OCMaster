<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OCMaster.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableXamlCompiledBindings>false</EnableXamlCompiledBindings>
    <EnableXamlCompilation>false</EnableXamlCompilation>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.4.240411001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Go DLL 嵌入为资源 (编译时需 copy 到项目目录) -->
  <ItemGroup>
    <EmbeddedResource Include="hardware_scanner.dll"
                      Condition="Exists('hardware_scanner.dll')"
                      LogicalName="OCMaster.App.hardware_scanner.dll" />
    <None Include="..\bin\hardware_scanner_*.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="hardware_scanner.dll"
          Condition="Exists('..\bin\hardware_scanner_*.dll')" />
  </ItemGroup>
</Project>
