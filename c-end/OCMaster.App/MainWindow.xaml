<Window x:Class="OCMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超频大师 OCMaster" Height="680" Width="960">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch"
                    Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefault}">
            <TextBlock Text="超频大师 OCMaster" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,20,0" />
            <Button x:Name="SettingsBtn" Content="设置" Click="SettingsBtn_Click"
                    HorizontalAlignment="Right" Margin="20,0,0,0" />
        </StackPanel>

        <!-- Content Frame -->
        <Frame Grid.Row="1" x:Name="ContentFrame" Padding="24" />
    </Grid>
</Window>
